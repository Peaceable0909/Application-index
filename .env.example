NEXT_PUBLIC_SUPABASE_URL=https://awmyavwhqklfuctczkuu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apps Script web app (see apps-script/README section in README.md)
